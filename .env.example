# Required for production
DATABASE_URL="postgresql://username:password@localhost:5432/mindprobe"
# Optional explicit Neon connection; takes precedence over DATABASE_URL when set.
NEON_DATABASE_URL=""
SESSION_SECRET="replace-with-a-long-random-secret"

# Runtime settings (the production start script sets NODE_ENV)
NODE_ENV="production"
PORT="5000"

# Optional AI providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
PERPLEXITY_API_KEY=""
VENICE_API_KEY=""
XAI_API_KEY=""
# Optional legacy-compatible provider aliases
ZHI1_API_KEY=""
ZHI2_API_KEY=""
ZHI3_API_KEY=""
ZHI4_API_KEY=""

# Optional voice dictation and payments
ASSEMBLYAI_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET_MINDPROBE=""
VITE_STRIPE_PUBLISHABLE_KEY=""